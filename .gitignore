# Python 缓存
__pycache__/
*.pyc

# 本地配置与密钥（含 LLM API key，严禁入库）
.env

# 运行产物（每次运行自动生成,断点在 runtime/jobs）
runtime/
*.log

# 工具二进制与下载存档（体积大，不入库；由 tools/downloads/fetch_all.py 重新获取）
tools/bin/*.exe
tools/bin/*.bat
tools/foundry/
tools/jadx/
tools/sqlmap/
tools/jwt_tool/
tools/nikto/
tools/downloads/*.zip

# 会话记录
.pi-sessions/
llm-profiles.json

# 测试账号池（真实凭据，严禁入库）
credentials.txt

# 目标清单含真实在测目标,公开仓库不泄漏(模板: targets.example.txt)
targets.txt

# 实战战果台账与案例(含目标关联信息,不入公开仓库)
knowledge/experience/
jobs/
