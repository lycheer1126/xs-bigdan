# xs-bigdan 配置（复制为 .env 后填写）

# LLM（DeepSeek 直连示例；sk-35位为 DeepSeek 直连 key）
BIGDAN_LLM_KEY=
BIGDAN_LLM_BASE=https://api.deepseek.com/v1
BIGDAN_LLM_PROVIDER=deepseek
BIGDAN_LLM_MODEL=deepseek-v4-flash
BIGDAN_LLM_THINKING=medium

# 调度
BIGDAN_SEGMENTS=3
BIGDAN_SEGMENT_TIMEOUT_SEC=900
BIGDAN_JOBS_DIR=runtime/jobs
BIGDAN_OUTPUTS_DIR=runtime/outputs
